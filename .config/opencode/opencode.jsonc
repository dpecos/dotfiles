{
	"$schema": "https://opencode.ai/config.json",
	"lsp": true,
	"agent": {
		"build": {
			"model": "opencode/deepseek-v4-flash-free",
			"color": "#32CD32"
		},
		"architect": {
			"description": "Plans and analyzes dev tasks, delegates to @developer.",
			"mode": "primary"
		},
		"developer": {
			"description": "Implements code changes delegated by @architect.",
			"mode": "subagent"
		},
		"local": {
			"description": "Agent running on local LLM",
			"mode": "primary",
			"model": "ollama/gemma4:12b-mlx"
		}
	},
	"plugin": ["opencode-gemini-auth@latest"],
	"provider": {
		"ollama": {
			"npm": "@ai-sdk/openai-compatible",
			"options": {
				"baseURL": "http://localhost:11434/v1"
			},
			"models": {
				"gemma4:12b-mlx": {}
			}
		}
	}
}
