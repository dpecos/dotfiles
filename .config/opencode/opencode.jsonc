{
	"$schema": "https://opencode.ai/config.json",
	"lsp": true,
	"agent": {
		"build": {
			"model": "opencode/deepseek-v4-flash-free",
			"color": "#32CD32"
		},
		"architect": {
			"description": "Plans and analyzes dev tasks, delegates to @developer.",
			"mode": "primary"
		},
		"developer": {
			"description": "Implements code changes delegated by @architect.",
			"mode": "subagent"
		}
	}
}

