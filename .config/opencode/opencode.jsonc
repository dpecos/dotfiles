{
	"$schema": "https://opencode.ai/config.json",
	"lsp": true,
	"agent": {
		"build": {
			"model": "opencode/deepseek-v4-flash-free",
			"color": "#32CD32"
		},
		"plan": {
			"model": "opencode/deepseek-v4-flash-free",
			"color": "#1E90FF",
			"disable": true
		},
		"general": {
			"model": "opencode/deepseek-v4-flash-free",
			"color": "#FF69B4",
			"disable": true
		},
		"explore": {
			"model": "opencode/deepseek-v4-flash-free",
			"color": "#FFD700"
		},
		"scout": {
			"model": "opencode/deepseek-v4-flash-free",
			"color": "#8A2BE2",
			"disable": true
		},
		"compaction": {
			"model": "opencode/deepseek-v4-flash-free",
			"color": "#FF4500"
		},
		"title": {
			"model": "opencode/deepseek-v4-flash-free",
			"color": "#00CED1"
		},
		"summary": {
			"model": "opencode/deepseek-v4-flash-free",
			"color": "#FF1493"
		},
		"local": {
			"description": "Agent running on local LLM",
			"mode": "primary",
			"model": "ollama/gemma4:12b-mlx"
		},
		"architect": {
			//"model:": "github-copilot/claude-sonnet-4.6",
			// "model": "google/gemini-3.1-flash-lite"
			"model": "opencode-go/glm-5.2"
		},
		"fullstack-developer": {
			//"model:": "github-copilot/claude-sonnet-4.6",
			//"model": "google/gemini-3.1-flash-lite",
			// "model": "opencode/deepseek-v4-flash-free"
			"model": "opencode-go/deepseek-v4-flash"
		}
	},
	"plugin": ["./plugins/caveman/plugin.js"],
	"provider": {
		"ollama": {
			"npm": "@ai-sdk/openai-compatible",
			"options": {
				"baseURL": "http://localhost:11434/v1"
			},
			"models": {
				"gemma4:12b-mlx": {}
			}
		}
	},
	"mcp": {
		"caveman-shrink": {
			"type": "local",
			"command": ["npx", "-y", "caveman-shrink"],
			"enabled": false
		},
		"sentry": {
			"type": "remote",
			"url": "https://mcp.sentry.dev/mcp",
			"oauth": {}
		}
	}
}
