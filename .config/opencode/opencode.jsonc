{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "architect",
  "lsp": true,
  "agent": {
    "architect": {
      "description": "Plans and analyzes dev tasks, delegates to @developer.",
      "mode": "primary",
      "model": "github-copilot/claude-sonnet-4-6",
      "color": "#4A90D9"
    },
    "developer": {
      "description": "Implements code changes delegated by @architect.",
      "mode": "subagent",
      "model": "opencode/deepseek-v4-flash-free",
      "color": "#50C878"
    }
  }
}